import { Theme, Icon } from "theme.slint";
import { Card, ModeCard, InfoBanner, ProxyActionButton, SecondaryButton, StatusPill, TextBox, HeaderButton, IpTag, AddTagButton } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// 字段标签
component FieldLabel inherits Text {
    font-size: Theme.font-sm;
    color: Theme.text-secondary;
}

export component SettingsPage inherits Rectangle {
    background: Theme.content-bg;
    animate background { duration: 120ms; }

    in-out property <string> mode;             // "windivert" | "relay"
    in-out property <string> peer_vips;
    in property <[string]> peer_ip_list;
    in-out property <string> server_vip;
    in-out property <string> client_ip;
    in-out property <string> ports;
    in property <bool> running;
    in property <string> local_ips_hint;

    callback start_proxy();
    callback stop_proxy();
    callback pick_process();
    callback open_settings();
    callback open_help();
    callback toggle_theme();
    callback open_add_ip_dialog();
    callback remove_peer_ip(int);

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 12px;

        // 页头
        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 0;
                spacing: 3px;
                Text {
                    text: "代理设置";
                    font-size: Theme.font-title;
                    font-weight: 800;
                    color: Theme.text-primary;
                    animate color { duration: 120ms; }
                }
                Text {
                    text: "通过虚拟网络连接房间，与好友一起征服世界";
                    font-size: Theme.font;
                    color: Theme.text-secondary;
                    animate color { duration: 120ms; }
                }
            }
            Rectangle { horizontal-stretch: 1; }  // spacer
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 12px;
                alignment: end;
                HeaderButton {
                    glyph: "\u{e713}";
                    text: "设置";
                    clicked => { root.open_settings(); }
                }
                HeaderButton {
                    glyph: "\u{e9ce}";
                    text: "帮助";
                    clicked => { root.open_help(); }
                }
                HeaderButton {
                    glyph: Theme.dark ? "\u{e706}" : "\u{e708}";
                    text: Theme.dark ? "浅色" : "深色";
                    clicked => { root.toggle_theme(); }
                }
            }
        }

        // 内容区
        ScrollView {
            VerticalLayout {
                spacing: 10px;
                alignment: start;

                // 运行模式卡片
                Card {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Image {
                                source: @image-url("assets/icon_network.svg");
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "运行模式";
                                font-size: Theme.font-lg;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            ModeCard {
                                horizontal-stretch: 1;
                                title: "同机模式 (本机就是游戏机)";
                                subtitle: "需管理员权限";
                                selected: root.mode == "windivert";
                                clicked => { root.mode = "windivert"; }

                                if root.mode == "windivert": Image {
                                    source: @image-url("assets/icon_monitor_accent.svg");
                                    width: 28px; height: 28px;
                                    y: (parent.height - self.height) / 2;
                                }
                                if root.mode != "windivert" && !Theme.dark: Image {
                                    source: @image-url("assets/icon_monitor_light.svg");
                                    width: 28px; height: 28px;
                                    y: (parent.height - self.height) / 2;
                                }
                                if root.mode != "windivert" && Theme.dark: Image {
                                    source: @image-url("assets/icon_monitor_dark.svg");
                                    width: 28px; height: 28px;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            ModeCard {
                                horizontal-stretch: 1;
                                title: "中转模式 (独立中转机)";
                                subtitle: "作为房间中转服务器运行";
                                selected: root.mode == "relay";
                                clicked => { root.mode = "relay"; }

                                if root.mode == "relay": Image {
                                    source: @image-url("assets/icon_server_accent.svg");
                                    width: 28px; height: 28px;
                                    y: (parent.height - self.height) / 2;
                                }
                                if root.mode != "relay" && !Theme.dark: Image {
                                    source: @image-url("assets/icon_server_light.svg");
                                    width: 28px; height: 28px;
                                    y: (parent.height - self.height) / 2;
                                }
                                if root.mode != "relay" && Theme.dark: Image {
                                    source: @image-url("assets/icon_server_dark.svg");
                                    width: 28px; height: 28px;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }

                // 同机模式字段：对端虚拟 IP + 右侧信息条
                if root.mode == "windivert": Card {
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Icon {
                                    glyph: "\u{e701}";
                                    font-size: 18px;
                                    color: Theme.accent;
                                    width: 20px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "对端虚拟 IP";
                                    font-size: Theme.font-lg;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for ip[idx] in root.peer_ip_list: IpTag {
                                    text: ip;
                                    remove => { root.remove_peer_ip(idx); }
                                }
                                AddTagButton {
                                    clicked => { root.open_add_ip_dialog(); }
                                }
                            }
                            Text {
                                text: "点击 + 添加其他玩家的虚拟局域网 IP 地址";
                                font-size: Theme.font-sm;
                                color: Theme.text-tertiary;
                            }
                        }
                        InfoBanner {
                            width: 38%;
                            text: "填入其他玩家的虚拟 IP；\n每台参与的机器都要以管理员运行本程序并互填对端。\n三台都使用本修正版；只通过虚拟网发现房间。\n端口填 62900。";
                        }
                    }
                }

                // 中转模式字段：服务端 VIP + 客户端真实 IP
                if root.mode == "relay": Card {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Image {
                                source: @image-url("assets/icon_network.svg");
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "中转参数";
                                font-size: Theme.font-lg;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                FieldLabel { text: "服务端虚拟 IP (VPN 内)"; }
                                TextBox { text <=> root.server_vip; placeholder: "172.16.0.223"; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                FieldLabel { text: "客户端真实局域网 IP"; }
                                TextBox { text <=> root.client_ip; placeholder: "10.0.0.10"; }
                            }
                        }
                    }
                }

                // 端口
                Card {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Icon {
                                glyph: "\u{e7f4}";
                                font-size: 18px;
                                color: Theme.accent;
                                width: 20px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "端口 (逗号分隔)";
                                font-size: Theme.font-lg;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            TextBox {
                                horizontal-stretch: 1;
                                text <=> root.ports;
                                placeholder: "62900";
                            }
                            SecondaryButton {
                                glyph: "\u{e8fd}";
                                text: "从程序选择…";
                                clicked => { root.pick_process(); }
                            }
                        }
                        Text {
                            text: root.local_ips_hint;
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                        }
                    }
                }
            }
        }

        // 底部操作条
        HorizontalLayout {
            spacing: 12px;
            alignment: end;
            StatusPill {
                running: root.running;
                y: (parent.height - self.height) / 2;
            }
            ProxyActionButton {
                running: root.running;
                clicked => {
                    if root.running {
                        root.stop_proxy();
                    } else {
                        root.start_proxy();
                    }
                }
            }
        }
    }
}
