import { Theme, Icon } from "theme.slint";
import { Card, ModeCard, InfoBanner, PrimaryButton, SecondaryButton, StatusPill, CheckBox, TextBox } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// 小节标题（图标 + 文本）
component SectionHeader inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    spacing: 10px;
    alignment: start;
    Icon { glyph: root.glyph; font-size: 20px; color: Theme.accent; width: 24px; }
    Text { text: root.title; font-size: Theme.font-lg; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
}

// 字段标签
component FieldLabel inherits Text {
    font-size: Theme.font-sm;
    color: Theme.text-secondary;
}

export component SettingsPage inherits Rectangle {
    in-out property <string> mode;             // "windivert" | "relay"
    in-out property <string> peer_vips;
    in-out property <string> server_vip;
    in-out property <string> client_ip;
    in-out property <string> ports;
    in-out property <bool> verbose;
    in property <bool> running;
    in property <string> local_ips_hint;

    callback start_proxy();
    callback stop_proxy();
    callback pick_process();
    callback open_settings();
    callback open_help();
    callback verbose_changed(bool);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // 页头
        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 0;
                spacing: 4px;
                Text { text: "代理设置"; font-size: Theme.font-title; font-weight: 800; color: Theme.text-primary; }
                Text { text: "通过虚拟网络连接房间，与好友一起征服世界"; font-size: Theme.font; color: Theme.text-secondary; }
            }
            Rectangle { horizontal-stretch: 1; }  // spacer
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 22px;
                alignment: end;
                Rectangle {
                    HorizontalLayout {
                        spacing: 6px;
                        Icon { glyph: "\u{e713}"; font-size: 18px; color: Theme.text-secondary; width: 20px; }
                        Text { text: "设置"; font-size: Theme.font; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.open_settings(); } }
                }
                Rectangle {
                    HorizontalLayout {
                        spacing: 6px;
                        Icon { glyph: "\u{e897}"; font-size: 18px; color: Theme.text-secondary; width: 20px; }
                        Text { text: "帮助"; font-size: Theme.font; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.open_help(); } }
                }
            }
        }

        // 可滚动内容（正常窗口高度下无需滚动）
        ScrollView {
            VerticalLayout {
                spacing: 12px;
                alignment: start;

                // 运行模式
                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        SectionHeader { glyph: "\u{e968}"; title: "运行模式"; }
                        HorizontalLayout {
                            spacing: 12px;
                            ModeCard {
                                horizontal-stretch: 1;
                                glyph: "\u{e977}";
                                title: "同机模式（本机就是游戏机）";
                                subtitle: "需管理员权限";
                                selected: root.mode == "windivert";
                                clicked => { root.mode = "windivert"; }
                            }
                            ModeCard {
                                horizontal-stretch: 1;
                                glyph: "\u{e968}";
                                title: "中转模式（独立中转机）";
                                subtitle: "作为房间中转服务器运行";
                                selected: root.mode == "relay";
                                clicked => { root.mode = "relay"; }
                            }
                        }
                    }
                }

                // 同机模式字段：对端虚拟 IP + 右侧信息条（用 if 而非 visible，隐藏时不占布局空间）
                if root.mode == "windivert": Card {
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            alignment: start;
                            SectionHeader { glyph: "\u{e701}"; title: "对端虚拟 IP（逗号分隔）"; }
                            TextBox {
                                text <=> root.peer_vips;
                                placeholder: "192.168.10.147,192.168.10.160";
                            }
                            Text { text: "示例: 192.168.10.147,192.168.10.160"; font-size: Theme.font-sm; color: Theme.text-tertiary; }
                        }
                        InfoBanner {
                            width: 38%;
                            text: "填入其他玩家的虚拟 IP；\n每台参与的机器都要以管理员运行本程序并互填对端。\n三台都使用本修正版；只通过虚拟网发现房间。\n端口填 62900。";
                        }
                    }
                }

                // 中转模式字段：服务端 VIP + 客户端真实 IP
                if root.mode == "relay": Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        SectionHeader { glyph: "\u{e968}"; title: "中转参数"; }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                FieldLabel { text: "服务端虚拟 IP (VPN 内)"; }
                                TextBox { text <=> root.server_vip; placeholder: "172.16.0.223"; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                FieldLabel { text: "客户端真实局域网 IP"; }
                                TextBox { text <=> root.client_ip; placeholder: "10.0.0.10"; }
                            }
                        }
                    }
                }

                // 端口
                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        SectionHeader { glyph: "\u{e977}"; title: "端口（逗号分隔）"; }
                        HorizontalLayout {
                            spacing: 12px;
                            TextBox {
                                horizontal-stretch: 1;
                                text <=> root.ports;
                                placeholder: "62900";
                            }
                            SecondaryButton {
                                height: 40px;
                                glyph: "\u{e8fd}";
                                text: "从程序选择…";
                                clicked => { root.pick_process(); }
                            }
                        }
                        Text { text: root.local_ips_hint; font-size: Theme.font-sm; color: Theme.text-secondary; }
                    }
                }
            }
        }

        // 底部操作条
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            PrimaryButton {
                glyph: "\u{e768}";
                text: "启动代理";
                enabled: !root.running;
                clicked => { root.start_proxy(); }
            }
            SecondaryButton {
                glyph: "\u{e71a}";
                text: "停止代理";
                enabled: root.running;
                clicked => { root.stop_proxy(); }
            }
            Rectangle { width: 1px; background: Theme.card-border; }
            CheckBox {
                label: "详细日志";
                checked <=> root.verbose;
                toggled(v) => { root.verbose_changed(v); }
            }
            Rectangle {}  // spacer
            StatusPill { running: root.running; }
        }
    }
}
