import { Theme, Icon } from "theme.slint";
import { NavItem, CaptionButton, AddIpDialog } from "components.slint";
import { LogLine } from "structs.slint";
import { SettingsPage } from "settings-page.slint";
import { LogsPage } from "logs-page.slint";
import { AboutPage } from "about-page.slint";
import { Palette } from "std-widgets.slint";

export { ProcessPickerWindow } from "process-picker.slint";
export { LogLine, ProcRow } from "structs.slint";
export { Theme } from "theme.slint";

// 左下角装饰插画：地球 + 虚线网络 + 两台电脑
component DecoGraphic inherits VerticalLayout {
    spacing: 8px;
    alignment: center;
    if !Theme.dark: Image {
        source: @image-url("assets/deco_light.svg");
        width: 140px;
        height: 102px;
        horizontal-alignment: center;
    }
    if Theme.dark: Image {
        source: @image-url("assets/deco_dark.svg");
        width: 140px;
        height: 102px;
        horizontal-alignment: center;
    }
    Text {
        text: "让文明的世界\n连接得更近";
        horizontal-alignment: center;
        font-size: Theme.font-sm;
        color: Theme.text-tertiary;
        animate color { duration: 120ms; }
    }
}

export component AppWindow inherits Window {
    title: "文明6 虚拟组网联机代理 v1.2 修正版";
    icon: @image-url("assets/app_icon.png");
    no-frame: true;
    default-font-size: Theme.font;
    background: Theme.window-bg;
    preferred-width: 1024px;
    preferred-height: 600px;
    min-width: 900px;
    min-height: 560px;

    // 主题模式（与 Theme.dark 和 C++ 双向同步）
    in-out property <bool> dark_mode <=> Theme.dark;
    init => { Palette.color-scheme = root.dark_mode ? ColorScheme.dark : ColorScheme.light; }

    // 配置数据（与 C++ 双向绑定）
    in-out property <string> mode: "windivert";
    in-out property <string> peer_vips;
    in property <[string]> peer_ip_list;
    in-out property <string> server_vip;
    in-out property <string> client_ip;
    in-out property <string> ports: "62900";
    in-out property <bool> verbose;
    in property <bool> running;
    in property <string> local_ips_hint: "本机检测到的局域网 IP: 未检测到";
    in property <string> version: "1.2 修正版";
    in property <[LogLine]> log_lines;
    in-out property <int> current_page: 0;    // 0 设置 / 1 日志 / 2 关于

    // 添加 IP 弹窗控制
    in-out property <bool> show_add_ip_dialog: false;
    in-out property <string> add_ip_input: "";
    in-out property <string> add_ip_error: "";

    // 行为回调
    callback start_proxy();
    callback stop_proxy();
    callback pick_process();
    callback verbose_changed(bool);
    callback open_settings();
    callback open_help();
    callback theme_changed(bool);
    callback add_peer_ip(string) -> string;
    callback remove_peer_ip(int);
    // 窗口控制（C++ 用 Win32 处理）
    callback minimize();
    callback maximize();
    callback close_window();

    VerticalLayout {
        spacing: 0px;

        // ---------------- 标题栏 ----------------
        Rectangle {
            height: 48px;
            background: Theme.sidebar-bg;
            animate background { duration: 120ms; }
            HorizontalLayout {
                // 拖动区：由 win_chrome 的 WM_NCHITTEST 判为 HTCAPTION，系统负责拖动/双击最大化
                Rectangle {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("assets/app_icon.png");
                                width: 22px;
                                height: 22px;
                            }
                        }
                        Text {
                            text: root.title;
                            vertical-alignment: center;
                            font-size: Theme.font;
                            font-weight: 700;
                            color: Theme.text-primary;
                            animate color { duration: 120ms; }
                        }
                    }
                }
                CaptionButton { glyph: "\u{e921}"; clicked => { root.minimize(); } }         // 最小化
                CaptionButton { glyph: "\u{e922}"; clicked => { root.maximize(); } }         // 最大化
                CaptionButton { glyph: "\u{e8bb}"; is-close: true; clicked => { root.close_window(); } } // 关闭
            }
        }

        // ---------------- 主体 ----------------
        HorizontalLayout {
            spacing: 0px;

            // 侧边栏
            Rectangle {
                width: 200px;
                background: Theme.sidebar-bg;
                animate background { duration: 120ms; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    NavItem {
                        glyph: "\u{e80f}"; label: "代理设置";
                        selected: root.current_page == 0;
                        clicked => { root.current_page = 0; }
                    }
                    NavItem {
                        glyph: "\u{e7c3}"; label: "运行日志";
                        selected: root.current_page == 1;
                        clicked => { root.current_page = 1; }
                    }
                    NavItem {
                        glyph: "\u{e946}"; label: "关于软件";
                        selected: root.current_page == 2;
                        clicked => { root.current_page = 2; }
                    }
                    Rectangle {}  // spacer
                    DecoGraphic {}
                    Rectangle { height: 12px; }
                }
            }

            // 内容区
            Rectangle {
                background: Theme.content-bg;
                animate background { duration: 120ms; }
                horizontal-stretch: 1;

                if root.current_page == 0: SettingsPage {
                    mode <=> root.mode;
                    peer_vips <=> root.peer_vips;
                    peer_ip_list: root.peer_ip_list;
                    server_vip <=> root.server_vip;
                    client_ip <=> root.client_ip;
                    ports <=> root.ports;
                    running: root.running;
                    local_ips_hint: root.local_ips_hint;
                    start_proxy => { root.start_proxy(); }
                    stop_proxy => { root.stop_proxy(); }
                    pick_process => { root.pick_process(); }
                    open_settings => { root.open_settings(); }
                    open_help => { root.open_help(); }
                    open_add_ip_dialog => {
                        root.add_ip_input = "";
                        root.add_ip_error = "";
                        root.show_add_ip_dialog = true;
                    }
                    remove_peer_ip(idx) => { root.remove_peer_ip(idx); }
                    toggle_theme => {
                        root.dark_mode = !root.dark_mode;
                        Palette.color-scheme = root.dark_mode ? ColorScheme.dark : ColorScheme.light;
                        root.theme_changed(root.dark_mode);
                    }
                }
                if root.current_page == 1: LogsPage {
                    lines: root.log_lines;
                    verbose <=> root.verbose;
                    verbose_changed(v) => { root.verbose_changed(v); }
                }
                if root.current_page == 2: AboutPage {
                    version: root.version;
                }
            }
        }
    }

    // 模态弹窗：添加对端虚拟 IP
    if root.show_add_ip_dialog: AddIpDialog {
        input_text <=> root.add_ip_input;
        error_text: root.add_ip_error;
        cancel => {
            root.show_add_ip_dialog = false;
            root.add_ip_input = "";
            root.add_ip_error = "";
        }
        confirm => {
            let err = root.add_peer_ip(root.add_ip_input);
            if err == "" {
                root.show_add_ip_dialog = false;
                root.add_ip_input = "";
                root.add_ip_error = "";
            } else {
                root.add_ip_error = err;
            }
        }
    }
}

