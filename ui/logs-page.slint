import { Theme, Icon } from "theme.slint";
import { LogLine } from "structs.slint";
import { CheckBox } from "components.slint";
import { ScrollView } from "std-widgets.slint";

export component LogsPage inherits Rectangle {
    in property <[LogLine]> lines;
    in-out property <bool> verbose;
    callback verbose_changed(bool);

    background: Theme.content-bg;
    animate background { duration: 120ms; }

    function level-color(level: string) -> color {
        if (level == "info") { return #4ec9b0; }
        if (level == "warn") { return #dcdcaa; }
        if (level == "error") { return #f48771; }
        return #808080; // debug
    }

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // 页头（标题 + 详细日志复选框）
        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text {
                    text: "运行日志";
                    font-size: Theme.font-title;
                    font-weight: 800;
                    color: Theme.text-primary;
                    animate color { duration: 120ms; }
                }
                Text {
                    text: "代理运行过程中的实时输出";
                    font-size: Theme.font;
                    color: Theme.text-secondary;
                    animate color { duration: 120ms; }
                }
            }
            CheckBox {
                label: "详细日志";
                checked <=> root.verbose;
                toggled(v) => { root.verbose_changed(v); }
            }
        }

        Rectangle {
            background: Theme.dark ? #0f1726 : #1e1e1e;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.card-border;
            clip: true;
            animate background, border-color { duration: 120ms; }
            ScrollView {
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    alignment: start;
                    for line in root.lines: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "[" + line.time + "]";
                            font-family: "Consolas";
                            font-size: 13px;
                            color: #8590a2;
                        }
                        Text {
                            text: line.text;
                            font-family: "Consolas";
                            font-size: 13px;
                            color: level-color(line.level);
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
